# Use absolute paths and an immutable source checkout during the run.
CODE_DIR=/path/to/genome-scale-pfp-adjust
DATA_DIR=/path/to/swissprot_proteomes_folds
ANNOTATION_DIR=/path/to/rebuilt-reference-annotations
RESOURCE_DIR=/path/to/versioned-ontology-resources
OUT_DIR=/path/to/new-results-directory
PYTHON=/path/to/environment/bin/python
GAEF_DIR=/path/to/GAEF
FUNTAXIS_MANIFEST=/path/to/downloaded-funtaxis/manifest.json
PROTEOME_ROOT=/path/to/uniprot_reference_proteomes
PROTEOME_INDEX=/path/to/genome-scale-pfp-adjust/data/uniprot_proteomes_ids.tsv
CP_SUBUNIT_INDEX=/path/to/curated/subunit_index.json
SLURM_ACCOUNT=pi-hohndor
SLURM_PARTITION=batch
AUDIT_WORKERS=36
AUDIT_TIME=12:00:00
AUDIT_MEMORY=64G

# Dense corrected-baseline metadata can exceed 1 GB compressed per organism.
AUDIT_AGGREGATE_MEMORY=128G
AUDIT_LINEAGE_MEMORY=128G
